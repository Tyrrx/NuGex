<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
        <SelfContained>true</SelfContained>
        <PublishTrimmed>true</PublishTrimmed>
        <InvariantGlobalization>true</InvariantGlobalization>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <DebugType>none</DebugType>
        <!-- The ModelContextProtocol SDK builds tool-parameter JSON schemas at runtime via
             reflection (our tool methods return untyped obj/obj[], so there's no source-generated
             contract for System.Text.Json to use instead). Trimming disables that reflection
             fallback by default, which crashes server startup with a NotSupportedException for
             System.Object[]. This feature switch keeps the fallback available. -->
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    </PropertyGroup>

    <ItemGroup>
        <!-- MSBuildWorkspace discovers these via MEF at runtime (scanning the output folder),
             not through any direct call site, so the trimmer can't see they're used and would
             otherwise silently delete them - breaking search_solution for C# projects. -->
        <TrimmerRootDescriptor Include="roots.xml" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Models.fs" />
        <Compile Include="RoslynApiVisitor.fs" />
        <Compile Include="SolutionProcessor.fs" />
        <Compile Include="PackageProcessor.fs" />
        <Compile Include="SearchService.fs" />
        <Compile Include="SolutionDiscovery.fs" />
        <Compile Include="Mcp.fs" />
        <Compile Include="Cli.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Argu" Version="6.2.5" />
      <PackageReference Include="FuzzySharp" Version="2.0.2" />
      <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.3.0" />
      <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
      <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.5" />
      <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
      <PackageReference Include="NuGet.Packaging" Version="7.3.0" />
      <PackageReference Include="NuGet.Protocol" Version="7.3.0" />
      <PackageReference Include="NuGet.Frameworks" Version="7.3.0" ExcludeAssets="runtime" PrivateAssets="all" />
    </ItemGroup>

</Project>
