<!--
  ILLink root descriptor: protects assemblies that MSBuildWorkspace discovers via MEF
  (scanning the output folder at runtime) rather than through any direct call site in
  NuGex's source. The trimmer's static reachability analysis can't see these uses, so
  without this file it silently deletes them - breaking search_solution for C# projects.
  See openspec/changes/shrink-nix-package-build/design.md for the full investigation.
-->
<linker>
  <assembly fullname="Microsoft.CodeAnalysis.CSharp.Workspaces">
    <type fullname="*" />
  </assembly>
  <assembly fullname="Microsoft.CodeAnalysis.Workspaces.MSBuild">
    <type fullname="*" />
  </assembly>
</linker>
